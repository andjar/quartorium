{
  "name": "quartorium-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Quartorium server: review rounds for Quarto documents, backed by plain Git",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/*.test.js'"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "nodemailer": "^7.0.13"
  }
}
